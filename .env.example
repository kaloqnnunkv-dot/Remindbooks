##############################################################################
#  ReMindBooks v2.0 — променливи на средата
#
#  Копирайте този файл като `.env` и попълнете стойностите.
#  НИКОГА не качвайте `.env` в Git — той съдържа тайни ключове.
#
#  Задължителни за стартиране:  DATABASE_URL, AUTH_SECRET, NEXT_PUBLIC_APP_URL
#  Всичко останало може да се добави по-късно — сайтът работи и без него,
#  като съответната функция просто е изключена.
##############################################################################

# --- База данни (задължително) ----------------------------------------------
# PostgreSQL. При Railway/Neon стойността се копира от таблото на доставчика.
DATABASE_URL="postgresql://user:password@localhost:5432/remindbooks"

# --- Основен адрес (задължително) -------------------------------------------
# Без наклонена черта накрая. В production: https://remindbooks.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Автентикация (задължително) --------------------------------------------
# Генерирайте с:  openssl rand -base64 32
AUTH_SECRET=""

# --- Вход с Google (по избор) -----------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# Разрешен redirect URI: https://ВАШИЯТ-ДОМЕЙН/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Stripe (плащания с карта) ----------------------------------------------
# Тестовите ключове започват с sk_test_ / pk_test_, реалните с sk_live_ / pk_live_
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# От Stripe Dashboard → Developers → Webhooks → endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# --- Хранилище за файлове (PDF, аудио, корици) -------------------------------
# S3-съвместимо. Препоръчително: Cloudflare R2 (без такса за трафик).
# Ако тези полета са празни, файловете се пазят локално в папка ./uploads —
# работи за разработка, но НЕ е подходящо за production без постоянен диск.
S3_ENDPOINT=""              # напр. https://<account-id>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Публичен домейн на bucket-а — оттам се сервират кориците.
NEXT_PUBLIC_MEDIA_HOST=""   # напр. media.remindbooks.com
LOCAL_UPLOAD_DIR="./uploads"

# --- Транзакционни имейли (Resend) ------------------------------------------
# Потвърждения на поръчки, линкове за сваляне, смяна на парола.
# Без този ключ имейлите само се логват в конзолата.
RESEND_API_KEY=""
EMAIL_FROM="ReMindBooks <noreply@remindbooks.com>"
# Тук пристигат съобщенията от формата за контакт и известията за наличности.
OWNER_EMAIL="info@remindbooks.com"

# --- MailerLite (бюлетин) ---------------------------------------------------
MAILERLITE_API_KEY=""
MAILERLITE_GROUP_ID=""

# --- Магазин ----------------------------------------------------------------
# Всички суми са в СТОТИНКИ (599 = 5,99 лв.)
SHIPPING_CENTS="599"
FREE_SHIPPING_OVER_CENTS="5000"    # 0 = без безплатна доставка
COD_FEE_CENTS="0"                  # такса за наложен платеж

# --- Функционалности по избор (true/false) ----------------------------------
FEATURE_COD="true"                 # наложен платеж
FEATURE_REVIEWS="true"             # рейтинг и ревюта
FEATURE_GIFT_CARDS="true"          # подаръчни карти
FEATURE_BLOG_COMMENTS="true"       # коментари в блога

# --- Контакти и социални мрежи (показват се в сайта) ------------------------
NEXT_PUBLIC_CONTACT_PHONE="+359 888 123 456"
NEXT_PUBLIC_CONTACT_EMAIL="info@remindbooks.com"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/remindbooks"
NEXT_PUBLIC_TIKTOK_URL="https://tiktok.com/@remindbooks"
NEXT_PUBLIC_INSTAGRAM_URL=""

# --- Начални данни (само за `npm run db:seed`) ------------------------------
SEED_ADMIN_EMAIL="admin@remindbooks.com"
SEED_ADMIN_PASSWORD="ReMind2026!"
